# deployments/home/deployment.env: the home deployment's hosts, paths, accounts and features, the one place they are set
# (PLT-33, DEC-45). Home is one deployment of the platform; ops/deployment.py says which one a machine runs.
# Read by compose (--env-file; compose/apps.yaml hands each container what it needs) and by ops/deployment.py (Python, and
# through it the shell scripts and the Makefile). A variable of the same name in the environment wins over this file.
# Plain NAME=value lines, no quotes; ${NAME} may name a line above. Never a secret: those stay in sops. ops/publish.py
# rewrites the values like any other file, so the public snapshot carries its placeholders here.

# Which deployment this is, and the features it switches on (docs/PLATFORM.md §3; core is always on). Compose reads
# COMPOSE_PROFILES from this file, so every compose call starts the services of these features and no others.
DEPLOYMENT=home
FEATURES=builder,mission-control,memory,home,phone,mail,voice,telegram,tailnet,web,publish,offsite,windows-desk,windows-worker
COMPOSE_PROFILES=${FEATURES}

# The account and the folders on the PC. The systemd units reach the same folders with %h and %t (ops/systemd/AGENTS.md).
DEPLOY_USER=owner
DEPLOY_HOME=/home/owner
STACK_DIR=${DEPLOY_HOME}/ai-stack
CODE_DIR=${DEPLOY_HOME}/code
SKILLS_DIR=${DEPLOY_HOME}/hermes-skills
DOCKER_SOCKET=unix:///run/user/1000/docker.sock

# Who commits, and the Windows account the first setup copies the Forgejo key from (ops/bootstrap-wsl-*.sh, ops/builds.py)
GIT_NAME=Owner
GIT_EMAIL=owner@example.com
WIN_USER=Owner

# The machines: the NAS and the PC on the home network, the PC and the AI phone on the tailnet
NAS_HOST=192.168.1.10
PC_LAN_HOST=192.168.1.20
PC_TAILNET_HOST=pc.example.ts.net
PHONE_HOST=100.64.0.10

# The services at those addresses
FORGEJO_URL=http://${NAS_HOST}:3000
FORGEJO_OWNER=regenzeus
HA_URL=http://${NAS_HOST}:8123
ROUTER_URL=http://fritz.box
MC_URL=https://${PC_TAILNET_HOST}:8447
# The app's name, as its pages, its installed icon, its guide and the stack's messages say it (APP-61)
APP_NAME="AI Stack"
