# deployments/platform/deployment.env: the platform only (PLT-44): the app, the engine (n8n) and the platform's upkeep,
# and no factory. A machine that names no deployment runs this, never home; `python3 ops/deployment.py new <name>` starts
# a new deployment from this folder. A factory comes on with FEATURES (home) or with a pack its packs.txt names.
# Plain NAME=value lines; ${NAME} names a line above or the environment (HOME, USER). Never a secret: those stay in sops.

DEPLOYMENT=platform
FEATURES=mission-control,memory
COMPOSE_PROFILES=${FEATURES}

# The account and the folders on the PC: the account that runs the stack (owner and /home/owner where neither is set)
DEPLOY_USER=${USER:-owner}
DEPLOY_HOME=${HOME:-/home/owner}
STACK_DIR=${DEPLOY_HOME}/ai-stack
CODE_DIR=${DEPLOY_HOME}/code
SKILLS_DIR=${DEPLOY_HOME}/hermes-skills
DOCKER_SOCKET=unix:///run/user/1000/docker.sock

# Who commits (placeholders until the site's owner sets them)
GIT_NAME=Owner
GIT_EMAIL=owner@example.com
WIN_USER=

# The home machines and services: home is off here, so empty
NAS_HOST=
PC_LAN_HOST=
PC_TAILNET_HOST=
PHONE_HOST=
FORGEJO_URL=
FORGEJO_OWNER=
HA_URL=
ROUTER_URL=
MC_URL=http://127.0.0.1:8090

# No tailnet: the app and n8n's editor inside it are reached on this PC (WFL-16), n8n's webhooks stay on 127.0.0.1
# (WFL-15), and the code map's gate is the loopback one (GEN-19)
APP_GATE=local
N8N_EDITOR_URL=http://127.0.0.1:8090/n8n/
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
CODEMAP_GATE=local
# The app's name, as its pages, its installed icon, its guide and the stack's messages say it (APP-61)
APP_NAME="AI Stack"
