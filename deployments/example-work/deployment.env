# deployments/example-work/deployment.env: an example of a work deployment, with placeholders (docs/PLATFORM.md).
# A real work deployment's folder lives only on its machine (outside this repository), named in ~/.config/aistack/deployment
# as a path. Values of features that are off stay empty: nothing that needs them runs.

DEPLOYMENT=example-work
FEATURES=builder,mission-control,memory,windows-worker
COMPOSE_PROFILES=${FEATURES}
# LiteLLM's configuration, written from models.yaml by ops/modelpolicy.py litellm (gateway models only)
LITELLM_CONFIG=../deployments/example-work/litellm.yaml

# The account and the folders on the PC
DEPLOY_USER=worker
DEPLOY_HOME=/home/worker
STACK_DIR=${DEPLOY_HOME}/ai-stack
CODE_DIR=${DEPLOY_HOME}/code
SKILLS_DIR=${DEPLOY_HOME}/hermes-skills
DOCKER_SOCKET=unix:///run/user/1000/docker.sock

# Who commits, and the Windows account of the owner (the Windows worker's broker runs as this account)
GIT_NAME=Example Owner
GIT_EMAIL=owner@example.com
WIN_USER=owner

# The home machines and services: off in this deployment, so empty
NAS_HOST=
PC_LAN_HOST=
PC_TAILNET_HOST=
PHONE_HOST=
FORGEJO_URL=
FORGEJO_OWNER=
HA_URL=
ROUTER_URL=
MC_URL=http://127.0.0.1:8090

# The forge: Bitbucket Data Center; this deployment never merges, its changes are draft pull requests (GEN-04)
FORGE=bitbucket-dc
FORGE_URL=https://bitbucket.example.com
MERGE=never
# The repositories in CODE_DIR are built where they are, never copied to Forgejo (GEN-18); a change's branch goes to the
# owner's fork as a draft pull request (docs/PLATFORM.md §7)
BUILD_REPOS=local
FORGE_PUSH=ssh://bitbucket.example.com:7999/~owner/{repo}.git
# A proxy for image builds only, empty when builds go out directly: ops/deploy.py hands it to each build as Docker's
# proxy build arguments, which stay out of the images and the containers (PLT-42)
BUILD_HTTP_PROXY=
BUILD_NO_PROXY=
# No tailnet here: the code map's gate is the loopback one (GEN-19)
CODEMAP_GATE=local
# No tailnet here: the app, and n8n's editor inside it, are reached on this PC at http://127.0.0.1:8090 (WFL-16), and
# n8n's webhooks and resume URLs stay on 127.0.0.1 (WFL-15); ops/deployment.py check refuses anything else
APP_GATE=local
N8N_EDITOR_URL=http://127.0.0.1:8090/n8n/
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
# Customer data (data.yaml): n8n loads only its logic nodes and the AI Stack step, no node that reaches a system itself
# (WFL-17); ops/dataguard.py check refuses a node off its list N8N_NODES
N8N_NODES_INCLUDE=["n8n-nodes-base.scheduleTrigger","n8n-nodes-base.webhook","n8n-nodes-base.manualTrigger","n8n-nodes-base.wait","n8n-nodes-base.if","n8n-nodes-base.switch","n8n-nodes-base.merge","n8n-nodes-base.splitInBatches","n8n-nodes-base.set","n8n-nodes-base.noOp","n8n-nodes-base.stickyNote","n8n-nodes-base.executeWorkflow","n8n-nodes-base.executeWorkflowTrigger","n8n-nodes-base.respondToWebhook","CUSTOM.aistackStep"]
# The app's name, as its pages, its installed icon, its guide and the stack's messages say it (APP-61)
APP_NAME="AI Stack"
