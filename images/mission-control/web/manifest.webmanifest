{
  "name": "AI Stack",
  "short_name": "AI Stack",
  "description": "Missions, agents, knowledge and costs of your AI stack",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#111317",
  "theme_color": "#111317",
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/static/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Chat",
      "url": "/#/chat"
    },
    {
      "name": "New task",
      "url": "/#/tasks?new=1"
    },
    {
      "name": "Stack",
      "url": "/#/system"
    },
    {
      "name": "Code",
      "url": "/#/build"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "text/*",
            ".pdf",
            ".docx",
            ".xlsx",
            ".csv",
            ".md",
            ".txt",
            ".json"
          ]
        }
      ]
    }
  }
}
