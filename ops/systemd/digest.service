[Unit]
Description=Morning digest on Telegram (no model calls)
[Service]
Type=oneshot
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/owner/ai-stack
ExecCondition=/usr/bin/python3 /home/owner/ai-stack/ops/stack_gate.py --wait 1800 --slot 8
ExecStart=/usr/bin/python3 ops/digest.py
