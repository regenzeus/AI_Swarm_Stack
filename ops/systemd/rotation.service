[Unit]
Description=Start tonight's trial of the weekly rotation when the stack is idle (TRL-14)
[Service]
Type=oneshot
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/owner/ai-stack
ExecCondition=/usr/bin/python3 /home/owner/ai-stack/ops/stack_gate.py --wait 1800
ExecStart=/usr/bin/python3 ops/rotation.py
TimeoutStartSec=3h
