[Unit]
Description=Start tonight's trial of the weekly rotation when the stack is idle (TRL-14)
[Service]
Type=oneshot
Environment=DOCKER_HOST=unix://%t/docker.sock
WorkingDirectory=%h/ai-stack
ExecCondition=/usr/bin/python3 %h/ai-stack/ops/stack_gate.py --wait 1800
ExecStart=/usr/bin/python3 ops/rotation.py
TimeoutStartSec=3h
