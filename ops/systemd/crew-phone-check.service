[Unit]
Description=Crew: Phone check: battery, storage, patch, connection, screen awake (weekly, Monday)
[Service]
Type=oneshot
TimeoutStartSec=1h
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/owner/ai-stack
ExecStart=/usr/local/bin/sops exec-env secrets/secrets.enc.yaml "sops exec-env secrets/agent-keys.enc.yaml \"python3 ops/crew.py phone-check\""
