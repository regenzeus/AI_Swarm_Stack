[Unit]
Description=Crew: the Coach (scorecards -> agent changes with evidence and a target score; each one is replayed before it may ship)
[Service]
Type=oneshot
TimeoutStartSec=3h30min
Environment=DOCKER_HOST=unix://%t/docker.sock
WorkingDirectory=%h/ai-stack
ExecCondition=/usr/bin/python3 %h/ai-stack/ops/stack_gate.py --wait 1800 --slot 110
ExecStart=/usr/local/bin/sops exec-env secrets/secrets.enc.yaml "sops exec-env secrets/agent-keys.enc.yaml \"python3 ops/crew.py coach\""
