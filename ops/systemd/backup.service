# feature: home
[Unit]
Description=Nightly encrypted backup to the NAS
[Service]
Type=oneshot
TimeoutStartSec=2h
Environment=DOCKER_HOST=unix://%t/docker.sock
WorkingDirectory=%h/ai-stack
ExecCondition=/usr/bin/python3 %h/ai-stack/ops/stack_gate.py --wait 1800 --slot 15 --need postgres,hindsight-db --no-gateway
ExecStart=/bin/bash -c "ops/backup.sh || { /usr/local/bin/sops exec-env secrets/secrets.enc.yaml 'ops/notify.sh \"Nightly backup failed, see: journalctl --user -u backup\"'; exit 1; }"
