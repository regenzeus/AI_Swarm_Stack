[Unit]
Description=Weekly learning run: eval-gated curator pass on Hermes skills, then vault lint
[Service]
Type=oneshot
TimeoutStartSec=5h
Environment=DOCKER_HOST=unix://%t/docker.sock
WorkingDirectory=%h/ai-stack
ExecCondition=/usr/bin/python3 %h/ai-stack/ops/stack_gate.py --wait 1800 --slot 60
ExecStart=/usr/local/bin/sops exec-env secrets/secrets.enc.yaml "sops exec-env secrets/agent-keys.enc.yaml \"python3 ops/curate.py\""
