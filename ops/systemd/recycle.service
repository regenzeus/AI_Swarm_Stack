[Unit]
Description=Restart the services that grow while idle (qmd, Phoenix, Open WebUI) when the stack is idle (PLT-27)
[Service]
Type=oneshot
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/owner/ai-stack
ExecStart=/usr/bin/python3 ops/recycle.py
TimeoutStartSec=90min
