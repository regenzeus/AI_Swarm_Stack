# feature: web
[Unit]
Description=Topic Desk: all active briefings now (manual; Mission Control schedules them)
[Service]
Type=oneshot
TimeoutStartSec=2h
Environment=DOCKER_HOST=unix://%t/docker.sock
WorkingDirectory=%h/ai-stack
ExecStart=/usr/local/bin/sops exec-env secrets/secrets.enc.yaml "sops exec-env secrets/agent-keys.enc.yaml \"bash ops/desk.sh\""
