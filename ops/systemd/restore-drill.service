[Unit]
Description=Weekly restore drill of the newest backup (changes nothing)
[Service]
Type=oneshot
TimeoutStartSec=3h
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/owner/ai-stack
ExecCondition=/usr/bin/python3 /home/owner/ai-stack/ops/stack_gate.py --wait 1800 --slot 75
ExecStart=/bin/bash -c "ops/restore.sh drill || { ops/notify.sh \"Weekly restore drill failed, see: journalctl --user -u restore-drill\"; exit 1; }"
