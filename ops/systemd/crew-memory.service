[Unit]
Description=Crew: the Memory Keeper: long-term memory, wiki disputes and re-checks, journals, the search index (its judgement and the wiki tidy on Wednesdays)
[Service]
Type=oneshot
TimeoutStartSec=3h30min
Environment=DOCKER_HOST=unix://%t/docker.sock
WorkingDirectory=%h/ai-stack
ExecCondition=/usr/bin/python3 %h/ai-stack/ops/stack_gate.py --wait 1800 --slot 45
ExecStart=/usr/local/bin/sops exec-env secrets/secrets.enc.yaml "sops exec-env secrets/agent-keys.enc.yaml \"python3 ops/crew.py memory\""
