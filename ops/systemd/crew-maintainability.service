[Unit]
Description=Crew: maintainability review (Claude Code, read-only) -> proposals
[Service]
Type=oneshot
TimeoutStartSec=2h
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/owner/ai-stack
ExecStart=/usr/local/bin/sops exec-env secrets/secrets.enc.yaml "sops exec-env secrets/agent-keys.enc.yaml \"python3 ops/crew.py maintainability\""
