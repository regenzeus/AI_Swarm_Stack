[Unit]
Description=After boot: wait for Hermes's tools behind LiteLLM, restart Hermes once so it sees them
After=docker.service
[Service]
Type=oneshot
TimeoutStartSec=15min
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/owner/ai-stack
ExecStart=/usr/local/bin/sops exec-env secrets/agent-keys.enc.yaml "python3 ops/stack_ready.py"
