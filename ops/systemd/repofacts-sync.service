# feature: builder
[Unit]
Description=Rebuild the facts of repositories whose HEAD moved
[Service]
Type=oneshot
# limit: stops (a run that hangs past 180 min is ended, so its timer fires again; the longest of 14 days was 318 s; review RUN-R27)
TimeoutStartSec=180min
Environment=DOCKER_HOST=unix://%t/docker.sock
ExecCondition=/usr/bin/python3 %h/ai-stack/ops/stack_gate.py
ExecStart=/usr/bin/python3 %h/ai-stack/ops/repofacts.py sync
