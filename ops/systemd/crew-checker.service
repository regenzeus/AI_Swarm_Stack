[Unit]
Description=Crew: the Checker: did each shipped idea work? (hourly, no model)
[Service]
Type=oneshot
TimeoutStartSec=20min
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/owner/ai-stack
ExecCondition=/usr/bin/python3 /home/owner/ai-stack/ops/stack_gate.py
ExecStart=/usr/local/bin/sops exec-env secrets/secrets.enc.yaml "sops exec-env secrets/agent-keys.enc.yaml \"python3 ops/crew.py checker\""
