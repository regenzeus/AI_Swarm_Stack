[Unit]
Description=Crew: journey checks: a task to its result, every screen at phone width, the e-mail, every make target (nightly, no model)
[Service]
Type=oneshot
TimeoutStartSec=45min
MemoryMax=1500M
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/owner/ai-stack
ExecStart=/usr/local/bin/sops exec-env secrets/secrets.enc.yaml "sops exec-env secrets/agent-keys.enc.yaml \"python3 ops/crew.py journeys\""
