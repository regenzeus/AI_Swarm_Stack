# Phoenix settings that keep traces, test sets, experiments and labels on the site (docs/spikes/EVAL.md, "Data class").
# Read from Phoenix 20.26.0's own config (phoenix/config.py in the pinned image) and seen in its start banner.
# The spike's throwaway Phoenix ran with exactly these; the core's Phoenix sets only the first today.

# No usage pixels (FullStory, Scarf) from the browser to Phoenix's makers.
PHOENIX_TELEMETRY_ENABLED=false
# Phoenix makes no public-internet request on its own: no web fonts, no telemetry, no WASM sandbox download.
PHOENIX_ALLOW_EXTERNAL_RESOURCES=false
# The in-app agent assistant (on by default since Phoenix 20) and its tools: web search and fetch, server-side bash,
# GitHub's hosted MCP server. Off: it would read traces and could send them out.
PHOENIX_DISABLE_AGENT_ASSISTANT=true
PHOENIX_AGENTS_DISABLE_WEB_ACCESS=true
PHOENIX_AGENTS_DISABLE_BASH=true
PHOENIX_AGENTS_DISABLE_GITHUB=true
# Code evaluators' sandboxes: none (the list includes hosted ones: E2B, Daytona, Vercel, Modal).
PHOENIX_ALLOWED_SANDBOX_PROVIDERS=NONE
# The playground's model providers: OpenAI-compatible only, pointed at the site's gateway by whoever uses it.
PHOENIX_ALLOWED_PROVIDERS=OPENAI
# Left unset on purpose: PHOENIX_COLLECTOR_ENDPOINT and PHOENIX_AGENTS_COLLECTOR_ENDPOINT (remote export).
